# =============================================================
# BrickByBrick — Variables de entorno
# Copiar a .env y completar los valores
# =============================================================

# Base de datos (Neon o Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/brickbybrick?sslmode=require"

# JWT
JWT_SECRET="cambiar-por-secreto-largo-y-aleatorio-32-chars-min"
JWT_REFRESH_SECRET="cambiar-por-otro-secreto-largo-y-aleatorio-32-chars"

# Supabase (storage de archivos)
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_KEY="eyJ..."                  # Service Role Key (no anon key)
SUPABASE_BUCKET="brickbybrick-assets"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="noreply@brickbybrick.co"
SMTP_PASS="contraseña-o-app-password"
EMAIL_FROM="BrickByBrick <noreply@brickbybrick.co>"

# Puertos de los microservicios
PORT_AUTH=3001
PORT_USERS=3002
PORT_MATERIALS=3003
PORT_EVENTS=3004
PORT_PUBS=3005
PORT_NOTIF=3006

# Frontend (CORS)
FRONTEND_URL="http://localhost:4200"

# Clave interna para comunicación entre servicios
INTERNAL_API_KEY="clave-secreta-inter-servicios-cambiar"

# Entorno
NODE_ENV="development"
