# =============================================================
# BrickByBrick — Variables de entorno (copiar a .env)
# =============================================================

NODE_ENV=development

# Base de datos. Local con Docker: postgresql://brickbybrick:brickbybrick_dev@localhost:5434/brickbybrick
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/brickbybrick?sslmode=require"

# JWT (mínimo 32 caracteres, distintos entre sí)
JWT_SECRET="cambiar-por-secreto-largo-y-aleatorio-de-32-caracteres-min"
JWT_REFRESH_SECRET="cambiar-por-otro-secreto-largo-y-aleatorio-de-32-caracteres"

# Clave para la comunicación interna entre servicios (mínimo 16 caracteres)
INTERNAL_API_KEY="cambiar-clave-interna-inter-servicios"

# URL pública del frontend (CORS y enlaces de los correos)
FRONTEND_URL="http://localhost:4200"

# Puertos
PORT_GATEWAY=3000
PORT_AUTH=3001
PORT_USERS=3002
PORT_MATERIALS=3003
PORT_EVENTS=3004
PORT_PUBS=3005
PORT_NOTIF=3006

# URLs internas de los servicios (opcional; por defecto http://localhost:<puerto>).
# En Docker Compose se definen con el nombre del contenedor.
# AUTH_SERVICE_URL=http://auth-service:3001
# NOTIF_SERVICE_URL=http://notification-service:3006

# Archivos subidos
# UPLOADS_DIR=/ruta/absoluta/uploads
MAX_UPLOAD_MB=10

# Correo:
#   log    → imprime los correos (y códigos MFA) en la consola/logs
#   smtp   → usa SMTP_* (Railway lo bloquea en los planes Trial y Hobby)
#   resend → API de Resend (https://resend.com); requiere RESEND_API_KEY y un EMAIL_FROM de un dominio verificado
MAIL_TRANSPORT=log
# RESEND_API_KEY=re_xxxxxxxx
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="noreply@brickbybrick.co"
SMTP_PASS="app-password"
EMAIL_FROM="BrickByBrick <noreply@brickbybrick.co>"

# Despliegue (imagen Docker todo en uno / Railway)
# PORT=3000                       puerto público del gateway (Railway lo define)
# CLIENT_IP_HEADER=x-real-ip      cabecera con la IP real del cliente detrás del proxy de la plataforma
# ADMIN_EMAIL=admin@tudominio.co  administrador inicial en producción
# ADMIN_PASSWORD=                 obligatoria en producción para crear el administrador (mín. 10, mayúscula, minúscula y número)
# SEED_DEMO=true                  carga cuentas y datos de demostración (contraseñas públicas: solo para demos)
# STORAGE_DRIVER=local            dónde se guardan los archivos subidos: local (UPLOADS_DIR) o db (PostgreSQL, para hosting sin disco)
# PROCESOS=varios                 varios (un proceso por servicio) o uno (todos en un proceso: menos RAM/CPU)
# BCRYPT_ROUNDS=12                costo del cifrado de contraseñas (10–14); 10 en instancias con muy poca CPU

# Nivel del logger (por defecto: debug en desarrollo, error en pruebas, warn en producción)
# LOG_LEVEL=info

# Pruebas: base aislada (su nombre debe terminar en _test). Si no se define,
# se deriva de DATABASE_URL cambiando el nombre de la base a brickbybrick_test.
# TEST_DATABASE_URL=postgresql://brickbybrick:brickbybrick_dev@localhost:5434/brickbybrick_test
